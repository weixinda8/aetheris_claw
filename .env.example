# Aetheris 化工厂智能排产系统 - 环境变量配置示例
# 复制此文件为 .env 并修改为你的实际配置

# ==============================================================================
# 企业微信配置
# ==============================================================================
# Webhook URL: 从企业微信管理后台获取
# 文档: https://developer.work.weixin.qq.com/document/path/91770
WECHAT_WORK_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key-here
WECHAT_WORK_SECRET=your-secret-here
WECHAT_WORK_CORP_ID=wwyour-corp-id-here

# ==============================================================================
# 钉钉配置
# ==============================================================================
# Webhook URL: 从钉钉机器人管理后台获取
# 文档: https://open.dingtalk.com/document/robots/custom-robot-access
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token-here
DINGTALK_SECRET=your-secret-here

# ==============================================================================
# 飞书配置
# ==============================================================================
# Webhook URL: 从飞书开放平台获取
# 文档: https://open.feishu.cn/document/ukTMukTMukTM/uETM4YjLxEDO24SMxgjn
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-hook-here
FEISHU_APP_ID=cli_your-app-id-here
FEISHU_APP_SECRET=your-app-secret-here

# ==============================================================================
# 微信 ilink 配置（个人微信）
# ==============================================================================
# ilink 是一个微信个人号消息转发服务
# 配置你的 ilink 服务地址和凭证
WECHAT_ILINK_URL=https://ilink.your-company.com
WECHAT_APP_ID=your-ilink-app-id
WECHAT_APP_SECRET=your-ilink-app-secret

# ==============================================================================
# LLM 配置
# ==============================================================================
# OpenAI API Key: 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=sk-your-openai-api-key

# 可选：使用其他 LLM 提供商
# ANTHROPIC_API_KEY=sk-ant-your-key-here
